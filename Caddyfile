seoja.be, www.seoja.be {
    redir / /lji/home.html 302
    redir /lji /lji/home.html 302
    redir /lji/ /lji/home.html 302

    root * C:\seoja.be

    @server path /server /server/*
    error @server 404

    php_fastcgi 127.0.0.1:9000 {
        try_files {path} =404
    }

    redir /favicon.ico /resources/favicon.ico 301

    file_server

    handle_errors {
        @404 expression {err.status_code} == 404
        handle @404 {
            rewrite * /lji/error.html
            file_server
        }
    }
}