seoja.be, www.seoja.be {
    redir / /lji/home.html 302
    root * C:\seoja.be
    file_server

    handle_errors {
        @404 expression {err.status_code} == 404
        handle @404 {
            rewrite * /lji/error.html
            file_server
        }
    }
}

:8080 {
    root * C:\seoja.be\lji
    file_server
}